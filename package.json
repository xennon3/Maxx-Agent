{
  "name": "maxx",
  "version": "0.1.0",
  "description": "A local-first terminal coding agent for LM Studio and other OpenAI-compatible servers",
  "type": "module",
  "bin": {
    "maxx": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/maxx",
    "build:look": "bun scripts/build-look.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "chart.js": "4",
    "jpeg-js": "^0.4.4",
    "mermaid": "11",
    "pngjs": "^7.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2",
    "three": "0.180.0"
  }
}
